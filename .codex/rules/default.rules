prefix_rule(pattern=["/usr/bin/bash", "-lc", "cat > /home/zeshan6a/Projects/Stories/main.py <<'PY'\nimport argparse\nimport json\nimport re\nfrom pathlib import Path\nfrom typing import Any\n\nimport arabic_reshaper\nimport requests\nfrom bidi.algorithm import get_display\nfrom bs4 import BeautifulSoup, NavigableString\nfrom reportlab.lib.pagesizes import A4\nfrom reportlab.pdfbase import pdfmetrics\nfrom reportlab.pdfbase.ttfonts import TTFont\nfrom reportlab.pdfgen import canvas\n\nURDU_RE = re.compile(r\"[\\u0600-\\u06FF]\")\nDEFAULT_HEADERS = {\n    \"User-Agent\": (\n        \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) \"\n        \"AppleWebKit/537.36 (KHTML, like Gecko) \"\n        \"Chrome/124.0.0.0 Safari/537.36\"\n    ),\n    \"Accept\": \"text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8\",\n    \"Accept-Language\": \"en-US,en;q=0.9\",\n}\n\nPDF_SKIP_EXACT = {\n    \"گھر کا بھیدی (پارٹ ون) - Love Story Forum\",\n    \"گھر کا بھیدی (پارٹ ون)\",\n    \"ہماری ٹاپ کلاس کہانیاں پڑھنے کے لیے ہمارے فورم کو\",\n    \"جوائن کریں\",\n    \"گاؤں سے شہر تک۔۔۔۔(قسط 40)\",\n    \"گاؤں سے شہر تک۔۔۔۔(قسط 39)\",\n    \"گاؤں سے شہر تک۔۔۔۔(قسط 38)\",\n    \"گاؤں سے شہر تک۔۔۔۔(قسط 37)\",\n    \"گاؤں سے شہر تک۔۔۔۔(قسط 36)\",\n}\n\n\ndef has_urdu(text: str) -> bool:\n    return bool(URDU_RE.search(text))\n\n\ndef shape_rtl_text(text: str) -> str:\n    reshaped = arabic_reshaper.reshape(text)\n    return get_display(reshaped)\n\n\ndef normalize_text(text: str) -> str:\n    return \" \".join(text.replace(\"\\n\", \" \").split()).strip()\n\n\ndef should_skip_in_pdf(text: str) -> bool:\n    clean = normalize_text(text)\n    return clean in PDF_SKIP_EXACT\n\n\ndef fetch_html(url: str, timeout: int = 30) -> str:\n    response = requests.get(url, headers=DEFAULT_HEADERS, timeout=timeout)\n    response.raise_for_status()\n    return response.text\n\n\ndef get_own_text(element: Any) -> str:\n    parts: list[str] = []\n    for child in element.children:\n        if isinstance(child, NavigableString):\n            text = str(child).strip()\n            if text:\n                parts.append(text)\n    return \" \".join(parts)\n\n\ndef extract_urdu_elements(html: str, leaf_only: bool = True) -> list[dict[str, Any]]:\n    soup = BeautifulSoup(html, \"html.parser\")\n\n    for node in soup([\"script\", \"style\", \"noscript\", \"svg\"]):\n        node.decompose()\n\n    results: list[dict[str, Any]] = []\n    for element in soup.find_all(True):\n        if leaf_only:\n            text = get_own_text(element)\n        else:\n            text = element.get_text(\" \", strip=True)\n\n        if not text or not has_urdu(text):\n            continue\n\n        results.append(\n            {\n                \"tag\": element.name,\n                \"id\": element.get(\"id\"),\n                \"class\": element.get(\"class\", []),\n                \"text\": text,\n            }\n        )\n\n    return results\n\n\ndef _find_urdu_font() -> str | None:\n    candidates = [\n        \"/usr/share/fonts/noto/NotoNaskhArabic-Regular.ttf\",\n        \"/usr/share/fonts/noto/NotoNastaliqUrdu-Regular.ttf\",\n        \"/usr/share/fonts/noto/NotoSansArabic-Regular.ttf\",\n        \"/usr/share/fonts/gnu-free/FreeSerif.otf\",\n    ]\n    for path in candidates:\n        if Path(path).exists():\n            return path\n    return None\n\n\ndef _wrap_text_for_pdf(text: str, font_name: str, font_size: int, max_width: float) -> list[str]:\n    words = text.split()\n    if not words:\n        return [\"\"]\n\n    lines: list[str] = []\n    current = words[0]\n    for word in words[1:]:\n        attempt = f\"{current} {word}\"\n        if pdfmetrics.stringWidth(attempt, font_name, font_size) <= max_width:\n            current = attempt\n        else:\n            lines.append(current)\n            current = word\n    lines.append(current)\n    return lines\n\n\ndef export_elements_pdf(elements: list[dict[str, Any]], output_path: str, source_url: str) -> None:\n    c = canvas.Canvas(output_path, pagesize=A4)\n    page_width, page_height = A4\n    left_margin = 40\n    right_margin = 40\n    top_margin = 40\n    bottom_margin = 40\n    usable_width = page_width - left_margin - right_margin\n    line_height = 14\n\n    font_name = \"Helvetica\"\n    font_size = 10\n\n    urdu_font_path = _find_urdu_font()\n    if urdu_font_path:\n        pdfmetrics.registerFont(TTFont(\"UrduFont\", urdu_font_path))\n        font_name = \"UrduFont\"\n\n    y = page_height - top_margin\n\n    def draw_line(line: str, rtl: bool = False) -> None:\n        nonlocal y\n        if y < bottom_margin:\n            c.showPage()\n            c.setFont(font_name, font_size)\n            y = page_height - top_margin\n\n        if rtl:\n            shaped = shape_rtl_text(line)\n            c.drawRightString(page_width - right_margin, y, shaped)\n        else:\n            c.drawString(left_margin, y, line)\n        y -= line_height\n\n    c.setFont(font_name, font_size)\n    draw_line(\"Urdu HTML Element Extraction Report\")\n    draw_line(f\"Source URL: {source_url}\")\n    draw_line(\"\")\n\n    for item in elements:\n        text = normalize_text(item[\"text\"])\n        if should_skip_in_pdf(text):\n            continue\n\n        meta = f\"<{item['tag']}> id={item['id']!r} class={item['class']}\"\n        for line in _wrap_text_for_pdf(meta, font_name, font_size, usable_width):\n            draw_line(line)\n\n        for line in _wrap_text_for_pdf(text, font_name, font_size, usable_width):\n            draw_line(line, rtl=has_urdu(line))\n\n        draw_line(\"\")\n\n    c.save()\n\n\ndef main() -> None:\n    parser = argparse.ArgumentParser(description=\"Extract Urdu-containing HTML elements.\")\n    parser.add_argument(\"url\", help=\"Target URL to parse\")\n    parser.add_argument(\"--limit\", type=int, default=50, help=\"Max elements to print\")\n    parser.add_argument(\"--json\", action=\"store_true\", help=\"Print JSON output\")\n    parser.add_argument(\n        \"--include-parent-text\",\n        action=\"store_true\",\n        help=\"Include full descendant text (more duplicates)\",\n    )\n    parser.add_argument(\n        \"--pdf-out\",\n        help=\"Write extracted elements to a PDF report at this path\",\n    )\n\n    args = parser.parse_args()\n\n    elements = extract_urdu_elements(\n        fetch_html(args.url),\n        leaf_only=not args.include_parent_text,\n    )\n    limited = elements[: max(args.limit, 0)]\n\n    print(f\"Found {len(elements)} Urdu-containing elements\")\n\n    if args.pdf_out:\n        export_elements_pdf(elements, args.pdf_out, args.url)\n        print(f\"PDF saved: {args.pdf_out}\")\n\n    if args.json:\n        print(json.dumps(limited, ensure_ascii=False, indent=2))\n        return\n\n    for idx, item in enumerate(limited, 1):\n        print(f\"{idx:03d}. <{item['tag']}> id={item['id']!r} class={item['class']}\")\n        print(item[\"text\"])\n\n\nif __name__ == \"__main__\":\n    main()\nPY"], decision="allow")
