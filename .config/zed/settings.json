{
  "context_servers": {
    "stitch": {
      "enabled": true,
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "YOUR_STITCH_API_KEY"
      }
    }
  },
  "git": {
    "disable_git": false
  },
  "ui_font_family": "JetBrains Mono NL",
  "buffer_font_family": "JetBrains Mono NL",
  "terminal": {
    "shell": {
      "program": "zsh"
    },
    "font_family": "JetBrains Mono"
  },
  "project_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "default_profile": "write",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow"
        }
      }
    },
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "provider": "openai-subscribed",
      "model": "gpt-5.6-luna",
      "enable_thinking": true,
    },
    "favorite_models": [],
    "model_parameters": [],
  },
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot",
  },
  "cli_default_open_behavior": "existing_window",
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "vim_mode": true,
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "collaboration_mode": "default",
        "reasoning_effort": "high",
        "model": "gpt-5.6-terra",
        "mode": "agent-full-access"
      },
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "ui_font_size": 18.0,
  "buffer_font_size": 20,
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 600,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Gruvbox Dark Hard",
  },
}
